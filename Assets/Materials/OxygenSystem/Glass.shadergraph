{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "a35ba8d2e4324be38941fb71474bf006",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GlassDirt (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 1161.0001220703125,
            "y": 376.0000305175781,
            "width": 259.0,
            "height": 190.00003051757813
        }
    },
    "m_Slots": [
        {
            "m_Id": "a35ba8d2e4324be38941fb71474bf007"
        },
        {
            "m_Id": "a35ba8d2e4324be38941fb71474bf008"
        },
        {
            "m_Id": "a35ba8d2e4324be38941fb71474bf009"
        },
        {
            "m_Id": "a35ba8d2e4324be38941fb71474bf00a"
        },
        {
            "m_Id": "a35ba8d2e4324be38941fb71474bf00b"
        },
        {
            "m_Id": "a35ba8d2e4324be38941fb71474bf00c"
        },
        {
            "m_Id": "a35ba8d2e4324be38941fb71474bf00d"
        },
        {
            "m_Id": "a35ba8d2e4324be38941fb71474bf00e"
        }
    ],
    "synonyms": [],
    "m_Precision": 1,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GlassDirt",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Object-space sampling keeps the dirt fixed to the glass.\nfloat3 pos = PositionOS * float3(6.0, 19.0, 6.0);\nfloat2 noise = 0.0;\n[unroll]\nfor (int layer = 0; layer < 2; layer++)\n{\n    float3 cell = floor(pos);\n    float3 blend = frac(pos);\n    blend = blend * blend * (3.0 - 2.0 * blend);\n\n    float seed = dot(cell, float3(1.0, 57.0, 113.0));\n    float4 corners = seed + float4(0.0, 1.0, 57.0, 58.0);\n    float4 nearCorners = frac(sin(corners * 0.3719) * 43758.5453);\n    float4 farCorners = frac(sin((corners + 113.0) * 0.3719) * 43758.5453);\n    float4 cornersXY = lerp(nearCorners, farCorners, blend.z);\n    float2 rows = lerp(cornersXY.xz, cornersXY.yw, blend.x);\n    noise[layer] = lerp(rows.x, rows.y, blend.y);\n    pos = pos * 3.6 + float3(5.7, 11.2, 8.4);\n}\n\nfloat stains = smoothstep(0.44, 0.73, noise.x);\nfloat specks = smoothstep(0.64, 0.86, noise.y) * 0.26;\nfloat dirt = saturate(stains * lerp(0.59, 0.86, noise.y) + specks) * saturate(DirtAmount);\nColor = lerp(CleanColor, float3(0.17, 0.135, 0.093), dirt);\nOpacity = lerp(CleanOpacity, 0.63, dirt);\nSmoothness = lerp(CleanSmoothness, 0.22, dirt);"
}

