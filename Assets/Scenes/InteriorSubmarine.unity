    - target: {fileID: 8116251457188271971, guid: 9117dfd5ded7db247953c24002a26609, type: 3}
      propertyPath: m_text
      value: "Marca los puntos de paso directamente sobre el mapa (  ) para trazar
        la ruta. Si te equivocas de rumbo, b\xF3rralo r\xE1pido (  ). \nEl submarino
        seguir\xE1 tus marcas a ciegas siempre que el motor est\xE9 en marcha; revisa
        bien los ecos del sonar antes de enviarnos directo contra un obst\xE1culo."
      objectReference: {fileID: 0}
    - target: {fileID: 8116251457188271971, guid: 9117dfd5ded7db247953c24002a26609, type: 3}
      propertyPath: m_fontSize
      value: 12
      objectReference: {fileID: 0}
    - target: {fileID: 8116251457188271971, guid: 9117dfd5ded7db247953c24002a26609, type: 3}
      propertyPath: m_fontSizeBase
      value: 12
      objectReference: {fileID: 0}
